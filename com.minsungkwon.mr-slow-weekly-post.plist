        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/minsungkwon/SynologyDrive/MSK_Code_NAS/mr-slow-landing/launchd_weekly_post.out.log</string>
    <key>StandardErrorPath</key>
