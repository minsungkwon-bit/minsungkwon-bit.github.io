<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minsungkwon.mr-slow-weekly-post</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/minsungkwon/SynologyDrive/MSK_Code_NAS/mr-slow-landing/run_weekly_post.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/minsungkwon/SynologyDrive/MSK_Code_NAS/mr-slow-landing</string>

    <!-- Run every Monday (Weekday 1) at 10:00 local time. -->
